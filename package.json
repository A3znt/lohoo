{
  "name": "social-orders",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@netlify/blobs": "^11.1.9",
    "expo": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "lucide-react": "^1.76.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "scripts": {
    "dev:webapp": "vite --config vite.config.mjs",
    "build:webapp": "node scripts/build-icons.mjs && vite build --config vite.config.mjs",
    "build:cloudflare": "npm run build:webapp && node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && node scripts/deploy-cloudflare.mjs",
    "typecheck:webapp": "tsc -p web/tsconfig.json --noEmit",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "lint": "expo lint"
  },
  "private": true
